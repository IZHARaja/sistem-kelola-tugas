{
  "info": {
    "name": "SiKelTugas API Test Collection",
    "description": "Koleksi pengujian API untuk aplikasi SiKelTugas - Sistem Kelola Tugas Sekolah.\nMencakup Auth, Guru, dan Siswa endpoints dengan validasi response.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {"key": "base_url", "value": "http://127.0.0.1:5000"},
    {"key": "guru_nip", "value": "NIP-UAS-001"},
    {"key": "guru_email", "value": "guru_uas@test.com"},
    {"key": "guru_name", "value": "Guru UAS"},
    {"key": "guru_password", "value": "Guru@1234!"},
    {"key": "siswa_nis", "value": "NIS-UAS-001"},
    {"key": "siswa_email", "value": "siswa_uas@test.com"},
    {"key": "siswa_name", "value": "Siswa UAS"},
    {"key": "siswa_password", "value": "Siswa@1234!"},
    {"key": "tugas_id", "value": "1"}
  ],
  "item": [
    {
      "name": "01 — Auth",
      "item": [
        {
          "name": "GET Portal Login Guru",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/login/guru"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contains login form', () => pm.expect(pm.response.text()).to.include('form'));",
                  "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Register Siswa",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/register/siswa"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Contains register form', () => pm.expect(pm.response.text()).to.include('Buat Akun'));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Register - Guru (Valid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register/guru",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "full_name", "value": "{{guru_name}}"},
                {"key": "email", "value": "{{guru_email}}"},
                {"key": "nis", "value": ""},
                {"key": "nip", "value": "{{guru_nip}}"},
                {"key": "password", "value": "{{guru_password}}"},
                {"key": "confirm_password", "value": "{{guru_password}}"},
                {"key": "role", "value": "dosen"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Register berhasil — redirect ke login', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Register - Siswa (Valid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register/siswa",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "full_name", "value": "{{siswa_name}}"},
                {"key": "email", "value": "{{siswa_email}}"},
                {"key": "nis", "value": "{{siswa_nis}}"},
                {"key": "nip", "value": ""},
                {"key": "password", "value": "{{siswa_password}}"},
                {"key": "confirm_password", "value": "{{siswa_password}}"},
                {"key": "role", "value": "mahasiswa"}
              ]
            }
          },
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Status 200 or 302', () => pm.expect(pm.response.code).to.be.oneOf([200,302]));"]}}]
        },
        {
          "name": "POST Login - Guru (Valid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login/guru",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "role", "value": "dosen"},
                {"key": "identifier", "value": "{{guru_nip}}"},
                {"key": "email", "value": "{{guru_email}}"},
                {"key": "full_name", "value": "{{guru_name}}"},
                {"key": "password", "value": "{{guru_password}}"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login guru — redirect ke dashboard', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "});",
                  "pm.test('Response time < 800ms', () => pm.expect(pm.response.responseTime).to.be.below(800));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Login - Wrong Password (Invalid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login/guru",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "role", "value": "dosen"},
                {"key": "identifier", "value": "{{guru_nip}}"},
                {"key": "email", "value": "{{guru_email}}"},
                {"key": "full_name", "value": "{{guru_name}}"},
                {"key": "password", "value": "WrongPass999"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login gagal — tetap di halaman login', () => pm.response.to.have.status(200));",
                  "pm.test('Tidak ada redirect ke dashboard', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('/guru/dashboard');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Logout",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Logout redirect ke login', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 — Guru Endpoints",
      "item": [
        {
          "name": "POST Login Guru (Session Setup)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login/guru",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "role", "value": "dosen"},
                {"key": "identifier", "value": "{{guru_nip}}"},
                {"key": "email", "value": "{{guru_email}}"},
                {"key": "full_name", "value": "{{guru_name}}"},
                {"key": "password", "value": "{{guru_password}}"}
              ]
            }
          }
        },
        {
          "name": "GET Guru Dashboard",
          "request": {"method": "GET", "url": "{{base_url}}/guru/dashboard"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dashboard guru 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Buat Tugas Form",
          "request": {"method": "GET", "url": "{{base_url}}/guru/tugas/buat"},
          "event": [{"listen": "test", "script": {"exec": ["pm.test('Form buat tugas 200', () => pm.response.to.have.status(200));"]}}]
        },
        {
          "name": "POST Buat Tugas (Valid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/guru/tugas/buat",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "judul", "value": "Tugas UAS Postman Test"},
                {"key": "deskripsi", "value": "Tugas ini dibuat melalui Postman untuk keperluan pengujian API otomatis."},
                {"key": "deadline", "value": "2030-12-31T23:59"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tugas berhasil dibuat (200/302)', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Submissions Tugas",
          "request": {"method": "GET", "url": "{{base_url}}/guru/tugas/{{tugas_id}}/submissions"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Halaman submissions 200 atau redirect', () => pm.expect(pm.response.code).to.be.oneOf([200, 302, 403, 404]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 — Siswa Endpoints",
      "item": [
        {
          "name": "POST Login Siswa (Session Setup)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/login/siswa",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "role", "value": "mahasiswa"},
                {"key": "identifier", "value": "{{siswa_nis}}"},
                {"key": "email", "value": "{{siswa_email}}"},
                {"key": "full_name", "value": "{{siswa_name}}"},
                {"key": "password", "value": "{{siswa_password}}"}
              ]
            }
          }
        },
        {
          "name": "GET Siswa Dashboard",
          "request": {"method": "GET", "url": "{{base_url}}/siswa/dashboard"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dashboard siswa 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response time < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Form Submit Tugas",
          "request": {"method": "GET", "url": "{{base_url}}/siswa/tugas/{{tugas_id}}/submit"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Form submit 200 atau redirect', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Submit Tugas - Teks (Valid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/siswa/tugas/{{tugas_id}}/submit",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "konten", "value": "Jawaban saya untuk tugas ini adalah menggunakan algoritma dynamic programming."}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Submit berhasil (200/302)', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Submit Tugas - Kosong (Invalid)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/siswa/tugas/{{tugas_id}}/submit",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "konten", "value": ""},
                {"key": "link_url", "value": ""}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Submit kosong ditolak (200 dengan error)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 — Security Tests",
      "item": [
        {
          "name": "Akses Guru Endpoint tanpa Login",
          "request": {"method": "GET", "url": "{{base_url}}/guru/dashboard"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Redirect ke login jika belum auth', () => pm.expect(pm.response.code).to.be.oneOf([200, 302]));"
                ]
              }
            }
          ]
        },
        {
          "name": "XSS Payload pada Nama Lengkap",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/register/siswa",
            "header": [{"key": "Content-Type", "value": "application/x-www-form-urlencoded"}],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {"key": "full_name", "value": "<script>alert(1)</script>"},
                {"key": "email", "value": "xss@test.com"},
                {"key": "nis", "value": "NISXSS01"},
                {"key": "nip", "value": ""},
                {"key": "password", "value": "Xss@1234!"},
                {"key": "confirm_password", "value": "Xss@1234!"},
                {"key": "role", "value": "mahasiswa"}
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('XSS payload tidak dieksekusi (tidak ada <script> di response)', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('<script>alert(1)</script>');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Path Traversal pada File Download",
          "request": {"method": "GET", "url": "{{base_url}}/uploads/../../../etc/passwd"},
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Path traversal diblokir (302/400/404)', () => pm.expect(pm.response.code).to.be.oneOf([302, 400, 403, 404]));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
